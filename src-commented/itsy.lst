   569 000001EF 8B3E[2A00]                      mov di,word[val_dp]           ; Load the dictionary pointer into DI.
   570                                                                        ; This is going to be the address that
   571                                                                        ; we copy the input word to. For the
   572                                                                        ; sake of tradition, let's call this
   573                                                                        ; scratchpad area the "pad".
   574 000001F3 57                              push di                       ; Save the pad pointer to the stack.
   575 000001F4 89DA                            mov dx,bx                     ; Copy the word separator to DX.
   576 000001F6 8B1E[4A00]                      mov bx,word[val_t_i_b]        ; Load the address of the input buffer
   577 000001FA 89D9                            mov cx,bx                     ; into BX, and save a copy to CX.
   578 000001FC 031E[1600]                      add bx,word[val_to_in]        ; Add the value of >in to the address
   579                                                                        ; of tib to get a pointer into the
   580                                                                        ; buffer.
   581 00000200 030E[2100]                      add cx,word[val_number_t_i_b] ; Add the value of #tib to the address
   582                                                                        ; of tib to get a pointer to the last
   583                                                                        ; chr in the input buffer.
   584 00000204 39D9                    wordf   cmp cx,bx                     ; Compare the current buffer pointer to
   585                                                                        ; the end-of-buffer pointer.
   586 00000206 7415                            je wordz                      ; If we've reached the end, jump.
   587 00000208 8A07                            mov al,byte[bx]               ; Get the next chr from the buffer
   588 0000020A 43                              inc bx                        ; and increment the pointer.
   589 0000020B 38D0                            cmp al,dl                     ; See if it's the separator.
   590 0000020D 74F5                            je wordf                      ; If so, jump.
   591 0000020F 47                      wordc   inc di                        ; Increment our pad pointer. Note that
   592                                                                        ; if this is our first time through the
   593                                                                        ; routine, we're incrementing to the
   594                                                                        ; 2nd address in the pad, leaving the
   595                                                                        ; first byte of it empty.
   596 00000210 8805                            mov byte[di],al               ; Write the new chr to the pad.
   597 00000212 39D9                            cmp cx,bx                     ; Have we reached the end of the
   598                                                                        ; input buffer?
   599 00000214 7407                            je wordz                      ; If so, jump.
   600 00000216 8A07                            mov al,byte[bx]               ; Get another byte from the input
   601 00000218 43                              inc bx                        ; buffer and increment the pointer.
   602 00000219 38D0                            cmp al,dl                     ; Is the new chr a separator?
   603 0000021B 75F2                            jne wordc                     ; If not, go back for more.
   604 0000021D C6450120                wordz   mov byte[di+1],32             ; Write a space at the end of the text
   605                                                                        ; we've written so far to the pad.
   606 00000221 A1[2A00]                        mov ax,word[val_dp]           ; Load the address of the pad into AX.
   607 00000224 97                              xchg ax,di                    ; Swap the pad address with the pad
   608 00000225 29F8                            sub ax,di                     ; pointer then subtract to get the
   609                                                                        ; length of the text in the pad.
   610                                                                        ; The result goes into AX, leaving the
   611                                                                        ; pad address in DI.
   612 00000227 8805                            mov byte[di],al               ; Save the length byte into the first
   613                                                                        ; byte of the pad.
   614 00000229 2B1E[4A00]                      sub bx,word[val_t_i_b]        ; Subtract the base address of the
   615                                                                        ; input buffer from the pointer value
   616                                                                        ; to get the new value of >in...
   617 0000022D 891E[1600]                      mov word[val_to_in],bx        ; ...then save it to its variable.
   618 00000231 5B                              pop bx                        ; Pop the value of the pad address
   619                                                                        ; that we saved earlier back out to
   620                                                                        ; the top of the stack as our return
   621                                                                        ; value.
   622 00000232 E9BAFE                          jmp next
