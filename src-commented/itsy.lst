   932 0000034E [1F00]                  interpt dw xt_number_t_i_b  ; Get the number of characters in the input
   933 00000350 [DE00]                          dw xt_fetch         ; buffer.
   934 00000352 [1400]                          dw xt_to_in         ; Get the index into the input buffer.
   935 00000354 [DE00]                          dw xt_fetch         ; 
   936 00000356 [CE00]                          dw xt_equals        ; See if they're the same.
   937 00000358 [FD00]                          dw xt_zero_branch   ; If not, it means there's still some text in
   938 0000035A [7003]                          dw intpar           ; the buffer. Go process it.
   939 0000035C [4800]                          dw xt_t_i_b         ; if #tib = >in, we're out of text and need to
   940 0000035E [8400]                          dw xt_lit           ; read some more. Put a 50 on the stack to tell
   941 00000360 3200                            dw 50               ; accept to read up to 50 more characters.
   942 00000362 [A001]                          dw xt_accept        ; Go get more input.
   943 00000364 [1F00]                          dw xt_number_t_i_b  ; Store into #tib the actual number of characters
   944 00000366 [E800]                          dw xt_store         ; that accept read.
   945 00000368 [8400]                          dw xt_lit           ; Reposition >in to index the 0th byte in the
   946 0000036A 0000                            dw 0                ; input buffer.
   947 0000036C [1400]                          dw xt_to_in         ; 
   948 0000036E [E800]                          dw xt_store         ; 
   949 00000370 [8400]                  intpar  dw xt_lit           ; Put a 32 on the stack to represent an ASCII
   950 00000372 2000                            dw 32               ; space character. Then tell word to scan the
   951 00000374 [ED01]                          dw xt_word          ; buffer looking for that character.
   952 00000376 [5A02]                          dw xt_find          ; Once word has parsed out a string, have find
   953                                                              ; see if that string matches the name of any
   954                                                              ; words already defined in the dictionary.
   955 00000378 [AC00]                          dw xt_dupe          ; Copy the flag returned by find, then jump if
   956 0000037A [FD00]                          dw xt_zero_branch   ; it's a zero, meaning that the string doesn't
   957 0000037C [9403]                          dw intnf            ; match any defined word names.
   958 0000037E [0A00]                          dw xt_state         ; We've got a word match. Are we interpreting or
   959 00000380 [DE00]                          dw xt_fetch         ; do we want to compile it? See if find's flag
   960 00000382 [CE00]                          dw xt_equals        ; matches the current value of state.
   961 00000384 [FD00]                          dw xt_zero_branch   ; If so, we've got an immediate. Jump.
   962 00000386 [8E03]                          dw intexc           ; 
   963 00000388 [6F00]                          dw xt_comma         ; Not immediate. Store the word's CFA in the
   964 0000038A [1101]                          dw xt_branch        ; dictionary then jump to the end of the loop.
   965 0000038C [CE03]                          dw intdone          ; 
   966 0000038E [2101]                  intexc  dw xt_execute       ; We found an immediate word. Execute it then
   967 00000390 [1101]                          dw xt_branch        ; jump to the end of the loop.
   968 00000392 [CE03]                          dw intdone          ; 
   969 00000394 [AC00]                  intnf   dw xt_dupe          ; Okay, it's not a word. Is it a number? Copy
   970                                                              ; the flag, which we've already proved is 0,
   971                                                              ; thereby creating a double-precision value of
   972                                                              ; 0 at the top of the stack. We'll need this
   973                                                              ; shortly when we call >number.
   974 00000396 [9100]                          dw xt_rote          ; Rotate the string's address to the top of
   975                                                              ; the stack. Note that it's still a counted
   976                                                              ; string.
   977 00000398 [4001]                          dw xt_count         ; Use count to split the string's length byte
   978                                                              ; apart from its text.
   979 0000039A [5501]                          dw xt_to_number     ; See if we can convert the text into a number.
   980 0000039C [FD00]                          dw xt_zero_branch   ; If we get a 0 from 0branch, we got a good
   981 0000039E [BA03]                          dw intskip          ; conversion. Jump and continue.
   982 000003A0 [0A00]                          dw xt_state         ; We had a conversion error. Find out whether
   983 000003A2 [DE00]                          dw xt_fetch         ; we're interpreting or compiling.
   984 000003A4 [FD00]                          dw xt_zero_branch   ; If state=0, we're interpreting. Jump
   985 000003A6 [B803]                          dw intnc            ; further down.
   986 000003A8 [3E00]                          dw xt_last          ; We're compiling. Shut the compiler down in an
   987 000003AA [DE00]                          dw xt_fetch         ; orderly manner. Get the LFA of the word we
   988 000003AC [AC00]                          dw xt_dupe          ; were trying to compile. Set aside a copy of it,
   989 000003AE [DE00]                          dw xt_fetch         ; then retrieve from it the LFA of the old "last
   990 000003B0 [3E00]                          dw xt_last          ; word" and resave that as the current last word.
   991 000003B2 [E800]                          dw xt_store         ; 
   992 000003B4 [2800]                          dw xt_dp            ; Now we have to save the LFA of the word we just
   993 000003B6 [E800]                          dw xt_store         ; tried to compile back into the dictionary
   994                                                              ; pointer.
   995 000003B8 [5400]                  intnc   dw xt_abort         ; Whether we were compiling or interpreting,
   996                                                              ; either way we end up here if we had an
   997                                                              ; unsuccessful number conversion. Call abort
   998                                                              ; and reset the system.
   999 000003BA [A100]                  intskip dw xt_drop          ; >number was successful! Drop the address and
  1000 000003BC [A100]                          dw xt_drop          ; the high word of the double-precision numeric
  1001                                                              ; value it returned. We don't need either. What's
  1002                                                              ; left on the stack is the single-precision
  1003                                                              ; number we just converted.
  1004 000003BE [0A00]                          dw xt_state         ; Are we compiling or interpreting?
  1005 000003C0 [DE00]                          dw xt_fetch         ; 
  1006 000003C2 [FD00]                          dw xt_zero_branch   ; If we're interpreting, jump on down.
  1007 000003C4 [CE03]                          dw intdone          ; 
  1008 000003C6 [8400]                          dw xt_lit           ; No, John didn't stutter here. These 4 lines are
  1009 000003C8 [8400]                          dw xt_lit           ; how "['] lit , ," get encoded. We need to store
  1010 000003CA [6F00]                          dw xt_comma         ; lit's own CFA into the word, followed by the
  1011 000003CC [6F00]                          dw xt_comma         ; number we just converted from text input.
  1012 000003CE [1101]                  intdone dw xt_branch        ; Jump back to the beginning of the interpreter
  1013 000003D0 [4E03]                          dw interpt          ; loop and process more input.
  1014                                  
  1015                                  freemem:
  1016                                  
  1017                                  ; That's it! So, there you have it! Only 33 named Forth words...
  1018                                  ;
  1019                                  ;     ,  @   >in  dup   base  word   abort   0branch   interpret
  1020                                  ;     +  !   lit  swap  last  find   create  constant  (;code)
  1021                                  ;     =  ;   tib  drop  emit  state  accept  >number
  1022                                  ;     :  dp  rot  #tib  exit  count  execute
  1023                                  ;
  1024                                  ; ...plus 6 pieces of headerless code and run-time routines...
  1025                                  ;
  1026                                  ;     getchar  outchar  docolon  dovar  doconst  next
  1027                                  ;
  1028                                  ; ...are all that's required to produce a functional Forth interpreter
  1029                                  ; capable of compiling colon definitions, only 978 bytes long! Granted,
  1030                                  ; it's lacking a number of key critical words that make it nigh unto
  1031                                  ; impossible to do anything useful, but this just goes to show just
  1032                                  ; how small a functioning Forth system can be made.
  1033                                  
