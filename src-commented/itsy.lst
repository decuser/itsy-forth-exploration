   523 000001A2 5F                              pop di        ; Pop the address of the string buffer into DI.
   524 000001A3 31C9                            xor cx,cx     ; Clear the CX register.
   525 000001A5 E89E00                  acceptl call getchar  ; Do the bios call to get a chr from the keyboard.
   526 000001A8 3C08                            cmp al,8      ; See if it's a backspace (ASCII character 08h).
   527 000001AA 7513                            jne acceptn   ; If not, jump for more testing.
   528 000001AC E319                            jcxz acceptb  ; "Jump if CX=0". If the user typed a backspace but
   529                                                        ; there isn't anything in the buffer to erase, jump
   530                                                        ; to the code that'll beep at him to let him know.
   531 000001AE E89C00                          call outchar  ; User typed a backspace. Go ahead and output it.
   532 000001B1 B020                            mov al,' '    ; Then output a space to wipe out the character that
   533 000001B3 E89700                          call outchar  ; the user had just typed.
   534 000001B6 B008                            mov al,8      ; Then output another backspace to put the cursor
   535 000001B8 E89200                          call outchar  ; back into position to read another character.
   536 000001BB 49                              dec cx        ; We just deleted a character. Now we need to decrement
   537 000001BC 4F                              dec di        ; both the counter and the buffer pointer.
   538 000001BD EBE6                            jmp acceptl   ; Then go back for another character.
   539 000001BF 3C0D                    acceptn cmp al,13     ; See if the input chr is a carriage return.
   540 000001C1 7412                            je acceptz    ; If so, we're done. jump to the end of the routine.
   541 000001C3 39D9                            cmp cx,bx     ; Compare current string length to the maximum allowed.
   542 000001C5 7507                            jne accepts   ; If the string's not too long, jump.
   543 000001C7 B007                    acceptb mov al,7      ; User's input is unusable in some way. Send the
   544 000001C9 E88100                          call outchar  ; BEL chr to make a beep sound to let him know.
   545 000001CC EBD7                            jmp acceptl   ; Then go back and let him try again.
   546 000001CE AA                      accepts stosb         ; Save the input character into the buffer. Note that
   547                                                        ; this opcode automatically increments the pointer
   548                                                        ; in the DI register.
