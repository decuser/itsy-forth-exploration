   550 000001D0 E87A00                          call outchar  ; Echo the input character back to the display.
   551 000001D3 EBD0                            jmp acceptl   ; Go back for another character.
   552 000001D5 E3F0                    acceptz jcxz acceptb  ; If the buffer is empty, beep at the user and go
   553                                                        ; back for more input.
