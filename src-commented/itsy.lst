   801 000002C3 [8400]0000                      dw xt_lit,0        ; Now put a zero on the stack...
   802 000002C7 [0A00]                          dw xt_state        ; along with the address of the state variable.
   803 000002C9 [E800]                          dw xt_store        ; Store the 0 into state to indicate that we're
   804                                                             ; done compiling a word and are now back into
   805                                                             ; interpret mode.
   806 000002CB [2F01]                          dw xt_exit         ; exit is the routine that finishes up the
   807                                                             ; execution of a colon definition and jumps to
   808                                                             ; next in order to start execution of the next
   809                                                             ; word.
