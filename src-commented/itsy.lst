   654 0000025C BF[4000]                        mov di,val_last    ; Get the address of the link field of the last
   655                                                             ; word in the dictionary. Put it in DI.
   656 0000025F 57                      findl   push di            ; Save the link field pointer.
   657 00000260 53                              push bx            ; Save the address of the name we're looking for.
   658 00000261 8A0F                            mov cl,byte[bx]    ; Copy the length of the string into CL
   659 00000263 B500                            mov ch,0           ; Clear CH to make a 16 bit counter.
   660 00000265 41                              inc cx             ; Increment the counter.
   661 00000266 8A4502                  findc   mov al,byte[di+2]  ; Get the length byte of whatever word in the
   662                                                             ; dictionary we're currently looking at.
   663 00000269 247F                            and al,07Fh        ; Mask off the immediate bit.
   664 0000026B 3A07                            cmp al,byte[bx]    ; Compare it with the length of the string.
   665 0000026D 740E                            je findm           ; If they're the same, jump.
   666 0000026F 5B                              pop bx             ; Nope, can't be the same if the lengths are
   667 00000270 5F                              pop di             ; different. Pop the saved values back to regs.
   668 00000271 8B3D                            mov di,word[di]    ; Get the next link address.
   669 00000273 85FF                            test di,di         ; See if it's zero. If it's not, then we've not
   670 00000275 75E8                            jne findl          ; hit the end of the dictionary yet. Then jump
   671                                                             ; back and check the next word in the dictionary.
   672 00000277 53                      findnf  push bx            ; End of dictionary. Word wasn't found. Push the
   673                                                             ; string address to the stack.
   674 00000278 31DB                            xor bx,bx          ; Clear the BX register (make a "false" flag).
   675 0000027A E972FE                          jmp next           ; Return to caller.
   676 0000027D 47                      findm   inc di             ; The lengths match, but do the chrs? Increment
   677                                                             ; the link field pointer. (That may sound weird,
   678                                                             ; especially on the first time through this loop.
   679                                                             ; But remember that, earlier in the loop, we
   680                                                             ; loaded the length byte out the dictionary by an
   681                                                             ; indirect reference to DI+2. We'll do that again
   682                                                             ; in a moment, so what in effect we're actually
   683                                                             ; doing here is incrementing what's now going to
   684                                                             ; be treated as a string pointer for the name in
   685                                                             ; the dictionary as we compare the characters
   686                                                             ; in the strings.)
   687 0000027E 43                              inc bx             ; Increment the pointer to the string we're
   688                                                             ; checking.
   689 0000027F E2E5                            loop findc         ; Decrements the counter in CX and, if it's not
   690                                                             ; zero yet, loops back. The same code that started
   691                                                             ; out comparing the length bytes will go through
   692                                                             ; and compare the characters in the string with
   693                                                             ; the chrs in the dictionary name we're pointing
   694                                                             ; at.
   695 00000281 5B                              pop bx             ; If we got here, then the strings match. The
   696                                                             ; word is in the dictionary. Pop the string's
   697                                                             ; starting address and throw it away. We don't
   698                                                             ; need it now that we know we're looking at a
   699                                                             ; defined word.
   700 00000282 5F                              pop di             ; Restore the link field address for the dictionary
   701                                                             ; word whose name we just looked at.
   702 00000283 BB0100                          mov bx,1           ; Put a 1 at the top of the stack.
   703 00000286 47                              inc di             ; Increment the pointer past the link field to the
   704 00000287 47                              inc di             ; name field.
   705 00000288 8A05                            mov al,byte[di]    ; Get the length of the word's name.
   706 0000028A A880                            test al,080h       ; See if it's an immediate.
   707 0000028C 7502                            jne findi          ; "test" basically performs an AND without
   708                                                             ; actually changing the register. If the
   709                                                             ; immediate bit is set, we'll have a non-zero
   710                                                             ; result and we'll skip the next instruction,
   711                                                             ; leaving a 1 in BX to represent that we found
   712                                                             ; an immediate word.
   713 0000028E F7DB                            neg bx             ; But if it's not an immediate word, we fall
   714                                                             ; through and generate a -1 instead to get the
   715                                                             ; flag for a non-immediate word.
   716 00000290 83E01F                  findi   and ax,31          ; Mask off all but the valid part of the name's
   717                                                             ; length byte.
   718 00000293 01C7                            add di,ax          ; Add the length to the name field address then
   719 00000295 47                              inc di             ; add 1 to get the address of the code field.
   720 00000296 57                              push di            ; Push the CFA onto the stack.
   721 00000297 E955FE                          jmp next           ; We're done.
