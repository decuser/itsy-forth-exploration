   631 00000246 B407                    getchar mov ah,7  ; This headerless routine does an MS-DOS Int 21h call,
   632 00000248 CD21                            int 021h  ; reading a character from the standard input device into
   633 0000024A B400                            mov ah,0  ; the AL register. We start out by putting a 7 into AH to
   634 0000024C C3                              ret       ; identify the function we want to perform. The character
   635                                                    ; gets returned in AL, and then we manually clear out
   636                                                    ; AH so that we can have a 16-bit result in AX.
   637                                  
   638 0000024D 92                      outchar xchg ax,dx  ; This headerless routine does an MS-DOS Int 21h call,
   639 0000024E B402                            mov ah,2    ; sending a character in the DL register to the standard
   640 00000250 CD21                            int 021h    ; output device. The 2 in the AH register identifies what
   641 00000252 C3                              ret         ; function we want to perform.
