     5                                  ; TODO
     6                                  ; Address Interpreter
     7                                  ; This interpreter fetches and executes CFAs in threaded code. It
     8                                  ; repeatedly reads the next code field address (CFA) from a word’s threaded
     9                                  ; sequence and jumps to execute that code. This loop is the core of Forth’s
    10                                  ; indirect-threaded execution model.
    11                                  
    12                                  ; Dictionary entries
    13                                  
    14                                  ; Text Interpreter
    15                                  ; This interpreter parses input, finds words, executes or compiles
    16                                  ; Handles input strings from the user or program, searches the dictionary
    17                                  ; for each word, and either executes it immediately or compiles it into a
    18                                  ; new definition depending on the current state.
    19                                  
    20                                  ; ------------------
    21                                  ; Version constants - enough for homegrown project
    22                                  ; ------------------
    23                                  major_version  equ 0
    24                                  minor_version  equ 1
    25                                  patch_version  equ 0
    26                                  
    27                                  ; -------------------------------------------------------------------
    28                                  ; Dictionary Entry Macro - used to build dictionary entries
    29                                  ; -------------------------------------------------------------------
    30                                  ; Defines the layout and construction of dictionary entries used by the
    31                                  ; Forth system. Each entry links to the previous one, stores its name and
    32                                  ; execution semantics, and includes an optional data field.
    33                                  ;
    34                                  ; Layout (64-bit fields unless noted):
    35                                  ;   LFA (link)   - pointer to previous dictionary entry
    36                                  ;   NFA (name)   - length-prefixed ASCII name
    37                                  ;   CFA (code)   - execution handler selector: PRIMITIVE | COLON | CONSTANT | VARIABLE
    38                                  ;   DFA (data)   - initial value or pointer; VARIABLES reside in writable memory
    39                                  ;
    40                                  ; Dictionary grows upward from dict_base, with HEAD pointing to the latest entry.
    41                                  ;
    42                                  ; Example usage:
    43                                  ;   DICT_ENTRY HEAD, 'dup', PRIMITIVE, NO_DFA
    44                                  ;   DICT_ENTRY dup, 'swap', PRIMITIVE, NO_DFA
    45                                  ;   DICT_ENTRY swap, 'rot', PRIMITIVE, NO_DFA
    46                                  ;   DICT_ENTRY rot, 'myvar', VARIABLE, 0
    47                                  ;   DICT_ENTRY myvar, 'myconst', CONSTANT, 123
    48                                  ;   DICT_ENTRY myconst, 'mycolon', COLON, NO_DFA
    49                                  
    50                                  %macro DICT_ENTRY 4
    51                                      dw %1                          ; link field (LFA)
    52                                      db %2 + %2:len, %2             ; name field (NFA), length-prefixed
    53                                      %if %3 = PRIMITIVE
    54                                          dq $+2                     ; code field (CFA), points to primitive code
    55                                      %elif %3 = COLON
    56                                          dq docolon                 ; CFA points to colon handler
    57                                      %elif %3 = CONSTANT
    58                                          dq doconst                 ; CFA points to constant handler
    59                                      %elif %3 = VARIABLE
    60                                          dq dovar                   ; CFA points to variable handler
    61                                      %endif
    62                                      dw %4                          ; data field (DFA)
    63                                  %endmacro
    64                                  
    65                                  ; -------------------------------------------------------------------
    66                                  ; Memory model design decisions
    67                                  ; -------------------------------------------------------------------
    68                                  ; Using a 16-bit virtual address space for dictionary and stacks
    69                                  ; within a 64-bit ELF64 environment. Memory is a single flat segment
    70                                  ; containing code, dictionary entries, and stack space.
    71                                  ;
    72                                  ; Growth directions:
    73                                  ; - Dictionary: upward from 0x0000
    74                                  ; - Data stack: downward from 0xFF00
    75                                  ; - Return stack: downward from 0xFE00
    76                                  ;
    77                                  ; This layout simplifies early development and allows expansion without
    78                                  ; changing allocation logic. Address calculations for words and runtime
    79                                  ; structures remain straightforward.
    80                                  
    81                                  ; -------------------------------------------------------------------
    82                                  ; Stacks and runtime data structures (bss and rodata)
    83                                  ; -------------------------------------------------------------------
    84                                  ; This implementation uses two software-managed stacks: a data stack and a return stack.
    85                                  ; The data stack holds operands, while the return stack holds return addresses, making
    86                                  ; nested word execution and colon definitions simpler. The hardware stack is left for
    87                                  ; CPU operations like interrupts and CALL/RET, keeping system control flow separate
    88                                  ; from Forth’s threaded execution.
    89                                  
    90                                  section .bss
    91                                  
    92 00000000 <res 2Ch>               orig_termios resb 44        ; termios struct for saving original settings
    93 0000002C <res 2Ch>               raw_termios  resb 44        ; termios struct for raw settings
    94                                  
    95                                  ; Program stack pointers
    96 00000058 ????????????????        dp:      resq 1    ; current data stack pointer
    97 00000060 ????????????????        rp:      resq 1    ; current return stack pointer
    98 00000068 ????????????????        latest:  resq 1    ; address of the most recent dictionary entry
    99                                  
   100                                  ; Program stack base addresses
   101                                  dict_base         equ 0x0000  ; start of dictionary space
   102                                  data_stack_base   equ 0xFF00  ; start of data stack
   103                                  return_stack_base equ 0xFE00  ; start of return stack
   104                                  
   105                                  section .rodata
   106                                  
   107                                  ; Static strings and constants used by the program. The banner is displayed
   108                                  ; at startup and its length is computed for use with write syscalls.
   109 00000000 495453593634207630-     banner: db "ITSY64 v", major_version + '0', ".", minor_version + '0', ".", patch_version + '0', 10
   109 00000009 2E312E300A         
   110                                  banner_len: equ $ - banner
   111                                  
   112                                  
   113                                  ; -------------------------------------------------------------------
   114                                  ; Code begins (text)
   115                                  ; -------------------------------------------------------------------
   116                                  section .text
   117                                  global _start
   118                                  
   119                                  ; ---
   120                                  ; Pure assembly helpers
   121                                  ; ---
   122                                  
   123                                  ; Data stack operations (RAX holds value)
   124                                  push_dp:
   125 00000000 488B1C25[58000000]          mov rbx, [dp]       ; load current top of data stack
   126 00000008 4883EB08                    sub rbx, 8          ; move down (stack grows downward)
   127 0000000C 488903                      mov [rbx], rax      ; store value at new top
   128 0000000F 48891C25[58000000]          mov [dp], rbx       ; update stack pointer
   129 00000017 C3                          ret
   130                                  
   131                                  pop_dp:
   132 00000018 488B1C25[58000000]          mov rbx, [dp]       ; load current top
   133 00000020 488B03                      mov rax, [rbx]      ; read value
   134 00000023 4883C308                    add rbx, 8          ; move pointer up
   135 00000027 48891C25[58000000]          mov [dp], rbx       ; update stack pointer
   136 0000002F C3                          ret
   137                                  
   138                                  ; Return stack operations (RAX holds return address)
   139                                  push_rp:
   140 00000030 488B1C25[60000000]          mov rbx, [rp]       ; load current top of return stack
   141 00000038 4883EB08                    sub rbx, 8
   142 0000003C 488903                      mov [rbx], rax
   143 0000003F 48891C25[60000000]          mov [rp], rbx
   144 00000047 C3                          ret
   145                                  
   146                                  pop_rp:
   147 00000048 488B1C25[60000000]          mov rbx, [rp]
   148 00000050 488B03                      mov rax, [rbx]
   149 00000053 4883C308                    add rbx, 8
   150 00000057 48891C25[60000000]          mov [rp], rbx
   151 0000005F C3                          ret
   152                                  
   153                                  ; Print message at RSI with length RDX
   154                                  print_msg:
   155 00000060 B801000000                  mov rax, 1          ; syscall: write
   156 00000065 BF01000000                  mov rdi, 1          ; stdout
   157 0000006A 0F05                        syscall
   158 0000006C C3                          ret
   159                                  
   160                                  ; ---
   161                                  ; Linux x86-64 syscall helpers 
   162                                  ; ---
   163                                  
   164                                  ; Minimal routines for Forth-style I/O and terminal control:
   165                                  ;
   166                                  ; set_raw_mode:
   167                                  ;   Uses ioctl (rax=16) with TCSETS (esi=0x5402) on stdin (rdi=0) to apply
   168                                  ;   a modified termios struct that disables ICANON and ECHO, enabling
   169                                  ;   raw single-character input.
   170                                  ;
   171                                  ; restore_original_mode:
   172                                  ;   Uses ioctl (rax=16) with TCSETS on stdin to restore the saved
   173                                  ;   original termios settings.
   174                                  ;
   175                                  ; getchar:
   176                                  ;   Uses read (rax=0) on stdin (rdi=0) to read one byte into a temporary
   177                                  ;   buffer, then returns the character in al (zero-extended in rax).
   178                                  ;
   179                                  ; outchar:
   180                                  ;   Uses write (rax=1) on stdout (rdi=1) to write the low 8 bits of rax
   181                                  ;   (al) to a temporary buffer and output one byte.
   182                                  ;
   183                                  ; exit_program:
   184                                  ;   Uses exit (rax=60) with the code in rdi to terminate the program.
   185                                  
   186                                  ; ---
   187                                  ; _copy_orig_to_raw
   188                                  ; ---
   189                                  ; Retrieves the current terminal settings into orig_termios using
   190                                  ; the TCGETS ioctl, then copies the structure to raw_termios.
   191                                  ; Used as the basis for enabling raw mode.
   192                                  
   193                                  _copy_orig_to_raw:
   194                                  
   195                                      ; Get current terminal attributes into orig_termios
   196                                      ; tcgetattr(0, &orig_termios)
   197 0000006D B810000000                  mov rax, 16             ; syscall number: ioctl
   198 00000072 BF00000000                  mov rdi, 0              ; fd = stdin
   199 00000077 BE01540000                  mov esi, 0x5401         ; TCGETS
   200 0000007C 488D1425[00000000]          lea rdx, [orig_termios]
   201 00000084 0F05                        syscall
   202                                  
   203                                      ; Copy orig_termios to raw_termios (44-byte termios struct)
   204 00000086 488D3425[00000000]          lea rsi, [orig_termios]
   205 0000008E 488D3C25[2C000000]          lea rdi, [raw_termios]
   206 00000096 B92C000000                  mov rcx, 44
   207 0000009B F3A4                        rep movsb
   208 0000009D C3                          ret
   209                                  
   210                                  ; ---
   211                                  ; set_raw_mode
   212                                  ; ---
   213                                  ; Copies the current terminal settings, clears ICANON and ECHO in
   214                                  ; c_lflag to enable raw mode, and applies the modified settings
   215                                  ; using the TCSETS ioctl.
   216                                  
   217                                  set_raw_mode:
   218 0000009E E8CAFFFFFF                  call _copy_orig_to_raw
   219                                  
   220                                      ; modify raw_termios for raw mode
   221                                      ; Clear ICANON and ECHO in c_lflag
   222 000000A3 488B0425[38000000]          mov rax, [raw_termios + 12]  ; c_lflag offset
   223 000000AB 4883E0F5                    and rax, ~(0x00002 | 0x00008)
   224 000000AF 48890425[38000000]          mov [raw_termios + 12], rax
   225                                  
   226                                      ; ------------------------
   227                                      ; tcsetattr(0, &raw_termios)
   228 000000B7 B810000000                  mov rax, 16                     ; syscall: ioctl
   229 000000BC BF00000000                  mov rdi, 0                      ; fd = stdin
   230 000000C1 BE02540000                  mov esi, 0x5402                 ; TCSETS
   231 000000C6 488D1425[2C000000]          lea rdx, [raw_termios]
   232 000000CE 0F05                        syscall
   233 000000D0 C3                          ret
   234                                  
   235                                  ; ---
   236                                  ; restore_original_mode
   237                                  ; ---
   238                                  ; Restores the saved terminal settings from orig_termios using
   239                                  ; the TCSETS ioctl.
   240                                  
   241                                  restore_original_mode:
   242                                      ; restore original settings
   243 000000D1 B810000000                  mov rax, 16                 ; syscall: ioctl
   244 000000D6 BF00000000                  mov rdi, 0                  ; fd = stdin
   245 000000DB BE02540000                  mov esi, 0x5402             ; TCSETS
   246 000000E0 488D1425[00000000]          lea rdx, [orig_termios]
   247 000000E8 0F05                        syscall
   248 000000EA C3                          ret
   249                                  
   250                                  ; ---
   251                                  ; getchar
   252                                  ; ---
   253                                  ; Reads a single byte from stdin using a temporary stack buffer.
   254                                  ; Returns the character in al (zero-extended in rax).
   255                                  
   256                                  getchar:
   257 000000EB 4883EC10                    sub rsp, 16             ; align stack and reserve space
   258 000000EF B800000000                  mov rax, 0              ; sys_read
   259 000000F4 BF00000000                  mov rdi, 0              ; fd = stdin
   260 000000F9 488D742408                  lea rsi, [rsp+8]        ; temporary buffer
   261 000000FE BA01000000                  mov rdx, 1              ; read 1 byte
   262 00000103 0F05                        syscall
   263 00000105 480FB6442408                movzx rax, byte [rsp+8] ; return character in rax
   264 0000010B 4883C410                    add rsp, 16
   265 0000010F C3                          ret
   266                                  
   267                                  
   268                                  ; ---
   269                                  ; outchar
   270                                  ; ---
   271                                  ; Writes the low 8 bits of rax (al) to stdout using a temporary
   272                                  ; stack buffer.
   273                                  
   274                                  outchar:
   275 00000110 4883EC10                    sub rsp, 16             ; align stack and reserve space
   276 00000114 88442408                    mov [rsp+8], al         ; store byte in temp buffer
   277 00000118 B801000000                  mov rax, 1              ; syscall: write
   278 0000011D BF01000000                  mov rdi, 1              ; fd = stdout
   279 00000122 488D742408                  lea rsi, [rsp+8]        ; buffer address
   280 00000127 BA01000000                  mov rdx, 1              ; write 1 byte
   281 0000012C 0F05                        syscall
   282 0000012E 4883C410                    add rsp, 16
   283 00000132 C3                          ret
   284                                  
   285                                  ; ---
   286                                  ; exit_program
   287                                  ; ---
   288                                  ; Exits the program using the value in rdi as the exit code.
   289                                  exit_program:
   290 00000133 B83C000000                  mov rax, 60        ; syscall: exit
   291 00000138 0F05                        syscall
   292                                  
   293                                  ; -------------------------------------------------------------------
   294                                  ; Program entry point
   295                                  ; -------------------------------------------------------------------
   296                                  ; Enables raw mode at startup, then enters a loop that
   297                                  ; reads a character into al, echoes it, and exits on 'q'.
   298                                  
   299                                  _start:
   300                                      
   301 0000013A E85FFFFFFF                  call set_raw_mode
   302                                  
   303                                  .loop:
   304 0000013F E8A7FFFFFF                  call getchar            ; returns char in al
   305 00000144 3C71                        cmp al, 'q'             ; exit on 'q'
   306 00000146 7407                        je .exit
   307 00000148 E8C3FFFFFF                  call outchar            ; writes al to stdout
   308                                  
   309                                  
   310 0000014D EBF0                        jmp .loop
   311                                  
   312                                  .exit:
   313 0000014F E87DFFFFFF                  call restore_original_mode
   314                                  
   315                                      ; exit
   316 00000154 BF00000000                  mov rdi, 0
   317 00000159 EBD8                        jmp exit_program        ; sys_exit
   318                                  
   319                                  
   320                                  
