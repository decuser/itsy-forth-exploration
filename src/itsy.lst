  1413                                  ;   <- colon [:] <- semicolon [;] <- create [(;code)] <- constant
  1414                                  ;   <- interpret
  1415                                  ;
  1416                                  ; With the outer interpreter now defined, this final chain fully supports
  1417                                  ; lookup, compilation, execution, and runtime extension of all Forth words.
