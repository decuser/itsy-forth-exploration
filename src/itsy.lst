  1407                                  ;
  1408                                  ;   0 <- state <- to_in [>in] <- ntib [#tib] <- dp <- base <- last <- tib
  1409                                  ;   <- abort <- comma [,] <- lit <- rot <- drop <- dup <- swap <- plus [+]
  1410                                  ;   <- equals [=] <- fetch [@] <- store [!]
  1411                                  ;   <- zero_branch [0branch] <- branch <- execute <- exit <- count
