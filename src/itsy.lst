  1360 000003C2 [FD00][CE03][8400]-                         dw cfa_zero_branch,intdone,cfa_lit,cfa_lit,cfa_comma  
  1360 000003C8 [8400][6F00]       
  1361                                  
  1362                                                      ; Store the converted number into the current word in the dictionary.  
  1363 000003CC [6F00]                                      dw cfa_comma
  1364                                  
  1365                                  ; ---------
  1366                                  ; Interpreter Loop Continuation: intdone
  1367                                  ;
  1368                                  ; This word marks the end of a single iteration of the outer interpreter.
  1369                                  ; It unconditionally jumps back to interpt to fetch and process the next word
  1370                                  ; from the input buffer, continuing the REPL loop.
  1371                                  ; ---------
  1372                                  intdone:
  1373                                                      ; Jump back to the start of the outer interpreter loop.
  1374 000003CE [1101][4E03]                                dw cfa_branch,interpt
  1375                                  
