  1215                                  ; -------------------------------------
  1216                                  ; -- Outer Interpreter (interpret)
  1217                                  ; -- Core Forth REPL (Process Input, Execute Words, Handle Control Flow)
  1218                                  ; -------------------------------------
  1219                                  ; The outer interpreter is implemented as an ordinary Forth word whose cfa is the first
  1220                                  ; executed when the system starts. si is preloaded with cfa_interpret+2, and control jumps
  1221                                  ; to next, which begins executing the threaded code of interpret just like any other word.
  1222                                  ; interpret reads input, parses words, manages state (compile vs interpret), and dispatches
  1223                                  ; execution through next. It drives the interactive Forth environment.
  1224                                  
  1225                                  ; ---------
  1226                                  ; -- Dictionary Word: interpret (Colon word)
  1227                                  ; -- Implements the Outer Interpreter
  1228                                  ; ---------
  1229                                  
  1230                                                                          ; interpret
  1231 00000340 [2603]                  lfa_interpret:      dw lfa_constant
  1232 00000342 09696E746572707265-     nfa_interpret:      db 9,'interpret'
  1232 0000034B 74                 
  1233 0000034C [AC02]                  cfa_interpret:      dw docolon
  1234                                  
  1235                                  ; ---------
  1236                                  ; Outer Interpreter Thread: interpt (interpreter)
  1237                                  ;
  1238                                  ; Entry point of the outer interpreter.
  1239                                  ; Reads input into the buffer, sets #tib to the number of characters read,
  1240                                  ; and initializes >in for parsing. Prepares the system to scan and interpret words.
  1241                                  ; ---------
  1242                                  interpt:            
  1243                                                      ; Fetch the value of the input buffer length and
  1244                                                      ; the current position index within it.
  1245 0000034E [1F00][DE00][1400]-                         dw cfa_ntib,cfa_fetch,cfa_to_in,cfa_fetch
  1245 00000354 [DE00]             
  1246                                  
  1247                                                      ; Compare the input buffer length with the current index
  1248                                                      ; If they are not equal, more text remains to be processed
  1249                                                      ; go get it
  1250 00000356 [CE00][FD00][7003]-                         dw cfa_equals,cfa_zero_branch,intpar,cfa_tib
  1250 0000035C [4800]             
  1251                                  
  1252                                                      ; Push 50 onto the stack to tell accept to read up to 50 characters.
  1253                                                      ; Store the actual number of characters read into #tib.
  1254 0000035E [8400]3200[A001]-                           dw cfa_lit,50,cfa_accept,cfa_ntib,cfa_store
  1254 00000364 [1F00][E800]       
  1255                                  
  1256                                                      ; Reset >in to 0 to start reading from the beginning of the input buffer.
  1257 00000368 [8400]0000[1400]-                           dw cfa_lit,0,cfa_to_in,cfa_store
  1257 0000036E [E800]             
  1258                                  
  1259                                  ; ---------
  1260                                  ; Parser and immediate word handler: intpar (parser)
  1261                                  ;
  1262                                  ; This code handles scanning the input buffer for the next word,
  1263                                  ; checks if it exists in the dictionary, determines whether it is
  1264                                  ; immediate, and executes it or compiles its CFA.
  1265                                  ; ---------
  1266                                  intpar:
  1267                                                      ; Push a space (ascii 32) onto the stack as delimiter.
  1268                                                      ; Use the word primitive to scan the input buffer up to that character.
  1269                                                      ; After parsing a string, use find to see if it matches a dictionary entry.
  1270                                                      ; Duplicate the result flag for further processing.
  1271 00000370 [8400]2000[ED01]-                           dw cfa_lit,32,cfa_word,cfa_find,cfa_dup
  1271 00000376 [5A02][AC00]       
  1272                                  
  1273                                                      ; If the flag from 'find' is zero, the string doesn't match any defined word.
  1274                                                      ; Otherwise, we have a word match - fetch the interpreter state (interpret/compile)
  1275                                                      ; to see whether to interpret or compile it.
  1276 0000037A [FD00][9403][0A00]-                         dw cfa_zero_branch,intnf,cfa_state,cfa_fetch
  1276 00000380 [DE00]             
  1277                                  
  1278                                                      ; If the found word is immediate jump to execute it; 
  1279                                                      ; otherwise, compile its CFA into the dictionary.
  1280 00000382 [CE00][FD00][8E03]-                         dw cfa_equals,cfa_zero_branch,intexc,cfa_comma
  1280 00000388 [6F00]             
  1281                                  
  1282                                                      ; and jump to the end of the interpreter loop, skipping any remaining 
  1283                                                      ; checks or compilation steps.
  1284 0000038A [1101][CE03]                                dw cfa_branch,intdone
  1285                                  
  1286                                  ; ---------
  1287                                  ; Immediate word executor: intexc (execute immediate)
  1288                                  ;
  1289                                  ; This code handles the case when a word is marked as immediate.
  1290                                  ; It executes the word’s CFA right away, bypassing compilation,
  1291                                  ; and then jumps to the end of the interpreter loop.
  1292                                  ; ---------
  1293                                  intexc:
  1294                                                      ; Execute its CFA immediately, then skip the remaining
  1295                                                      ; interpreter steps and jump to the end of the loop.
  1296 0000038E [2101][1101][CE03]                          dw cfa_execute,cfa_branch,intdone
  1297                                  
  1298                                  ; ---------
  1299                                  ; Number parsing and compilation handling: intnf (not found / number check)
  1300                                  ;
  1301                                  ; This code handles the case where the scanned string is not a dictionary word.
  1302                                  ; It prepares for >number conversion by duplicating and rotating the string,
  1303                                  ; splits the counted string into length and text, and attempts numeric conversion.
  1304                                  ;
  1305                                  ; If the conversion succeeds, control jumps to continue processing (intskip).
  1306                                  ; If it fails, the code checks whether we are interpreting or compiling.
  1307                                  ; For compilation, it manages the LFA of the current word and restores
  1308                                  ; the previous 'last' word in the dictionary to maintain dictionary consistency.
  1309                                  ; ---------
  1310                                  
  1311                                  intnf:
  1312                                                      ; It wasn't a word, is it as a number?
  1313                                                      ; Duplicate and rotate the string, split length from text,
  1314                                                      ; and call >number for conversion.
  1315 00000394 [AC00][9100][4001]-                         dw cfa_dup,cfa_rot,cfa_count,cfa_to_number
  1315 0000039A [5501]             
  1316                                  
  1317                                                      ; If >number succeeded (0 from 0branch), continue.
  1318                                                      ; Otherwise, check interpreter state to handle conversion error.
  1319 0000039C [FD00][BA03][0A00]-                         dw cfa_zero_branch,intskip,cfa_state,cfa_fetch
  1319 000003A2 [DE00]             
  1320                                  
  1321                                                      ; if state is 0, we're intrepreting, jump directly
  1322                                                      ; to the conversion error handler, otherwise get the
  1323                                                      ; lfa of the word we were trying to compile and set
  1324                                                      ; aside a copy of it
  1325 000003A4 [FD00][B803][3E00]-                         dw cfa_zero_branch,intnc,cfa_last,cfa_fetch,cfa_dup
  1325 000003AA [DE00][AC00]       
  1326                                  
  1327                                                      ; then restore the dictionary pointer to point to the end of the word we just compiled,
  1328                                                      ; ensuring the dictionary remains consistent for subsequent words
  1329 000003AE [DE00][3E00][E800]-                         dw cfa_fetch,cfa_last,cfa_store,cfa_dp,cfa_store
  1329 000003B4 [2800][E800]       
  1330                                  
  1331                                  ; ---------
  1332                                  ; Number Conversion Error Handler: intnc (conversion failure)
  1333                                  ;
  1334                                  ; This code is reached whenever a numeric conversion fails, regardless
  1335                                  ; of whether the system is in interpretation or compilation mode.
  1336                                  ; It calls the abort routine to reset the interpreter state and ensure
  1337                                  ; the system remains consistent.
  1338                                  ; ---------
  1339                                  intnc:
  1340                                                      ; Handle failed numeric conversion: reset the system by calling abort.
  1341 000003B8 [5400]                                      dw cfa_abort
  1342                                  
  1343                                  ; ---------
  1344                                  ; Post-Number Conversion Handler: intskip (successful conversion)
  1345                                  ;
  1346                                  ; This code handles the stack cleanup and compilation after a successful
  1347                                  ; numeric conversion. It drops the temporary values returned by >number,
  1348                                  ; leaving the converted single-precision number on the stack.
  1349                                  ; If interpreting, it jumps to continue processing.
  1350                                  ; If compiling, it encodes the literal by storing its CFA and the number
  1351                                  ; into the dictionary for later execution.
  1352                                  ; ---------
  1353                                  intskip:
  1354                                                      ; Success, drop the temporary address and high word from >number
  1355                                                      ; leave the converted number on the stack
  1356                                                      ; check interpreter state to decide next action.
  1357 000003BA [A100][A100][0A00]-                         dw cfa_drop, cfa_drop, cfa_state, cfa_fetch
  1357 000003C0 [DE00]             
  1358                                  
