  1112                                  ; ------------------------------
  1113                                  ; -- Forth Note - Complete Word Chain (Pre-Outer Interpreter)
  1114                                  ; ------------------------------
  1115                                  ; The dictionary now contains the head, core variables, and all
  1116                                  ; implemented primitives, including flow control, string, and
  1117                                  ; terminal I/O words. The inner interpreter (`next`) is fully
  1118                                  ; available, allowing these words to execute via their code field
  1119                                  ; addresses (cfa):
  1120                                  ;
  1121                                  ;   0 <- state <- to_in [>in] <- ntib [#tib] <- dp <- base <- last <- tib
  1122                                  ;   <- abort <- comma [,] <- lit <- rot <- drop <- dup <- swap <- plus [+]
  1123                                  ;   <- equals [=] <- fetch [@] <- store [!]
  1124                                  ;   <- zero_branch [0branch] <- branch <- execute <- exit <- count
  1125                                  ;   <- to_number [>number] <- accept <- word <- emit <- find
  1126                                  ;
  1127                                  ; Each entry links to the previous one, forming a complete dictionary
  1128                                  ; chain that supports lookup, compilation, and execution of all
  1129                                  ; primitives before the outer interpreter is fully active.
  1130                                  
  1131                                  ; -----------------------
