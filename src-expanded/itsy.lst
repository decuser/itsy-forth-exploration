   110 0000004C [4200]                  lfa_abort:          dw lfa_tib     ; prev-link
   111 0000004E 0561626F7274            nfa_abort:          db 5,'abort'    ; name len+string
   112 00000054 [5600]                  cfa_abort:          dw $+2          ; xt
   113                                  
