     1                                  ; assemble time variable for the head of the linked list of words
     2                                  %define head 0
     3                                  
     4                                  ; immediate mask
     5                                  immediate equ 080h
     6                                  
     7                                  ; Format of the linked list entries
     8                                  
     9                                  ;  LFA         =  LINK FIELD ADDRESS: a pointer to the next DEA
    10                                  ;  NFA         =  NAME FIELD ADDRESS: a pointer to a name buffer
    11                                  ;  CFA         =  CODE FIELD ADDRESS : a pointer to executable code
    12                                  ;  DFA         =  DATA FIELD ADDRESS : a pointer to data, empty for primitives
    13                                  
    14                                  ; macros during dev
    15                                  %macro header 4
    16                                  %%head dw head
    17                                  %define head %%head
    18                                  %strlen %%count %1
    19                                  db %3 + %%count,%1
    20                                  cfa_ %+ %2 dw %4
    21                                  %endmacro
    22                                  
    23                                  %macro primitive 2-3 0
    24                                  header %1,%2,%3,$+2
    25                                  %endmacro
    26                                  
    27                                  %macro colon 2-3 0
    28                                  header %1,%2,%3,docolon
    29                                  %endmacro
    30                                  
    31                                  %macro constant 3
    32                                  header %1,%2,0,doconst
    33                                  dfa_ %+ %2 dw %3
    34                                  %endmacro
    35                                  
    36                                  %macro variable 3
    37                                  header %1,%2,0,dovar
    38                                  dfa_ %+ %2 dw %3
    39                                  %endmacro
    40                                  
    41                                  ; this is a dos com, set origin to 100h and just to 
    42                                                      org 0100h
    43 00000000 EB54                                        jmp cfa_abort+2
    44                                  
    45                                  ; -------------------
    46                                  ; Forth Variables
    47                                  ; -------------------
    48                                   
    49                                  ; | Name  | Description                                          |
    50                                  ; | ----- | ---------------------------------------------------- |
    51                                  ; | state | Current interpreter state                            |
    52                                  ; | >in   | Input buffer index / current parse position          |
    53                                  ; | #tib  | Number of characters in the input buffer             |
    54                                  ; | dp    | Data pointer for dictionary or memory allocation     |
    55                                  ; | base  | Numeric base for number parsing/output               |
    56                                  ; | last  | Most recently compiled word or last dictionary entry |
    57                                  
    58                                  ; forth word - state
    59 00000002 0000                    lfa_state:          dw 0
    60 00000004 057374617465            nfa_state:          db 5,'state'
    61 0000000A [FC02]                  cfa_state:          dw dovar
    62 0000000C 0000                    dfa_state:          dw 0
    63                                  
    64                                  ; forth word - >in
    65 0000000E [0200]                  lfa_to_in:          dw lfa_state
    66 00000010 033E696E                nfa_to_in:          db 3,'>in'
    67 00000014 [FC02]                  cfa_to_in:          dw  dovar
    68 00000016 0000                    dfa_to_in:          dw 0
    69                                  
    70                                  ; forth word - #tib
    71 00000018 [0E00]                  lfa_ntib:           dw lfa_to_in
    72 0000001A 0423746962              nfa_ntib:           db 4,'#tib'
    73 0000001F [FC02]                  cfa_ntib:           dw  dovar
    74 00000021 0000                    dfa_ntib:           dw 0
    75                                  
    76                                  ; forth word - dp
    77 00000023 [1800]                  lfa_dp:             dw lfa_ntib
    78 00000025 026470                  nfa_dp:             db 2,'dp'
    79 00000028 [FC02]                  cfa_dp:             dw  dovar
    80 0000002A [D203]                  dfa_dp:             dw freemem
    81                                  
    82                                  ; forth word - base
    83 0000002C [2300]                  lfa_base:           dw lfa_dp
    84 0000002E 0462617365              nfa_base:           db 4,'base'
    85 00000033 [FC02]                  cfa_base:           dw  dovar
    86 00000035 0A00                    dfa_base:           dw 10
    87                                  
    88                                  ; forth word - last
    89 00000037 [2C00]                  lfa_last:           dw lfa_base
