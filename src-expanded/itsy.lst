    70                                  fw_state:
    71 00000002 0000                            dw 0
    72 00000004 057374617465                    db                  5,'state'
    73 0000000A [FC02]                          xt_state:           dw dovar
    74 0000000C 0000                            val_state:          dw 0
    75                                  
