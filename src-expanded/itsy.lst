   133 00000076 AB                                          stosw
   134 00000077 893E[2A00]                                  mov word[dfa_dp],di
   135 0000007B 5B                                          pop bx
   136 0000007C EB71                                        jmp next
   137                                  
   138                                  ; forth word - lit (primitive)
