    78 0000000E [0200]                          dw fw_state
    79 00000010 033E696E                        db                  3,'>in'
    80 00000014 [FC02]                          xt_to_in:           dw  dovar
    81 00000016 0000                            val_to_in:          dw 0
    82                                  
