   118 00000062 BC00FF                                      mov sp,-256
   119 00000065 BE[4E03]                                    mov si,cfa_interpret+2
   120 00000068 E98400                                      jmp next
   121                                  
   122                                  ; -------------------
   123                                  ; Compilation Primitives - Forth Dictionary Storage and Literal Embedding Words
   124                                  ; -------------------
   125                                  
   126                                  ; forth word - comma (primitive)
   127 0000006B [4C00]                  lfa_comma:          dw lfa_abort     ; prev-link
   128 0000006D 012C                    nfa_comma:          db 1,','        ; name len+string
   129 0000006F [7100]                  cfa_comma:          dw $+2          ; xt
   130                                  
   131 00000071 8B3E[2A00]                                  mov di,word[dfa_dp]
   132 00000075 93                                          xchg ax,bx
   133 00000076 AB                                          stosw
   134 00000077 893E[2A00]                                  mov word[dfa_dp],di
   135 0000007B 5B                                          pop bx
   136 0000007C EB71                                        jmp next
   137                                  
   138                                  ; forth word - lit (primitive)
   139 0000007E [6B00]                  lfa_lit:            dw lfa_comma     ; prev-link
   140 00000080 036C6974                nfa_lit:            db 3,'lit'    ; name len+string
   141 00000084 [8600]                  cfa_lit:            dw $+2          ; xt
   142                                  
   143 00000086 53                                          push bx
   144 00000087 AD                                          lodsw
   145 00000088 93                                          xchg ax,bx
   146 00000089 EB64                                        jmp next
   147                                  
