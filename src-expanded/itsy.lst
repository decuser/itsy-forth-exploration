     1                                  ; assemble time variable for the head of the linked list of words
     2                                  HEAD equ 0
     3                                  
     4                                  ; immediate mask
     5                                  IMMEDIATE equ 080h
     6                                  
     7                                  ; Format of the linked list entries
     8                                  
     9                                  ;  LFA         =  LINK FIELD ADDRESS: a pointer to the next forth word
    10                                  ;  NFA         =  NAME FIELD ADDRESS: a pointer to the words name
    11                                  ;  CFA         =  CODE FIELD ADDRESS : a pointer to executable code
    12                                  ;  DFA         =  DATA FIELD ADDRESS : a pointer to data, empty for primitives
    13                                  
    14                                  ; this is a dos com, set origin to 100h and just to 
    15                                                      org 0100h
    16 00000000 EB54                                        jmp cfa_abort+2
    17                                  
    18                                  ; -------------------
    19                                  ; Forth Variables
    20                                  ; -------------------
    21                                   
    22                                  ; | Name  | Description                                          |
    23                                  ; | ----- | ---------------------------------------------------- |
    24                                  ; | state | Current interpreter state                            |
    25                                  ; | >in   | Input buffer index / current parse position          |
    26                                  ; | #tib  | Number of characters in the input buffer             |
    27                                  ; | dp    | Data pointer for dictionary or memory allocation     |
    28                                  ; | base  | Numeric base for number parsing/output               |
    29                                  ; | last  | Most recently compiled word or last dictionary entry |
    30                                  
