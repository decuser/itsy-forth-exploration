   100                                  ;----------------------------------------------------
   101                                  ; System Foundational Primitives
   102                                  ;   Needed to initialize the Forth environment and 
   103                                  ;   support early runtime operations
   104                                  ;----------------------------------------------------
   105                                  ; -------------------
   106                                  ; Abort Primitive - Forth System Initialization Word
   107                                  ; -------------------
   108                                  
   109                                  ; forth word - abort (primitive)
   110 0000004C [4200]                  lfa_abort:          dw lfa_tib     ; prev-link
   111 0000004E 0561626F7274            nfa_abort:          db 5,'abort'    ; name len+string
   112 00000054 [5600]                  cfa_abort:          dw $+2          ; xt
   113                                  
   114 00000056 A1[2100]                                    mov ax,word[dfa_ntib]
   115 00000059 A3[1600]                                    mov word[dfa_to_in],ax
   116 0000005C 31ED                                        xor bp,bp
