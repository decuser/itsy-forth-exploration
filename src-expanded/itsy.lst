     1                                  ; assemble time variable for the head of the linked list of words
     2                                  %define head 0
     3                                  
     4                                  ; immediate mask
     5                                  immediate equ 080h
     6                                  
     7                                  ; Format of the linked list entries
     8                                  
     9                                  ; | Field                | Description                          |
    10                                  ; | -------------------- | ------------------------------------ |
    11                                  ; | Back-link            | Pointer to previous dictionary entry |
    12                                  ; | Name                 | Length byte + ASCII name of the word |
    13                                  ; | Execution token (xt) | Pointer to machine code for the word |
    14                                  ; | Value                | Runtime storage for the variable     |
    15                                  
    16                                  
    17                                  ; macros during dev
    18                                  %macro header 4
    19                                  %%head dw head
    20                                  %define head %%head
    21                                  %strlen %%count %1
    22                                  db %3 + %%count,%1
    23                                  xt_ %+ %2 dw %4
    24                                  %endmacro
    25                                  
    26                                  %macro primitive 2-3 0
    27                                  header %1,%2,%3,$+2
    28                                  %endmacro
    29                                  
    30                                  %macro colon 2-3 0
    31                                  header %1,%2,%3,docolon
    32                                  %endmacro
    33                                  
    34                                  %macro constant 3
    35                                  header %1,%2,0,doconst
    36                                  val_ %+ %2 dw %3
    37                                  %endmacro
    38                                  
    39                                  %macro variable 3
    40                                  header %1,%2,0,dovar
    41                                  val_ %+ %2 dw %3
    42                                  %endmacro
    43                                  
    44                                  ; this is a dos com, set origin to 100h and just to 
    45                                          org 0100h
    46 00000000 EB54                            jmp xt_abort+2
    47                                  
    48                                  ; -------------------
    49                                  ; Forth Variables
    50                                  ; -------------------
    51                                   
    52                                  ; | Name  | Description                                          |
    53                                  ; | ----- | ---------------------------------------------------- |
    54                                  ; | state | Current interpreter state                            |
    55                                  ; | >in   | Input buffer index / current parse position          |
    56                                  ; | #tib  | Number of characters in the input buffer             |
    57                                  ; | dp    | Data pointer for dictionary or memory allocation     |
    58                                  ; | base  | Numeric base for number parsing/output               |
    59                                  ; | last  | Most recently compiled word or last dictionary entry |
    60                                  
    61                                  ; assembly label prefixes
    62                                  
    63                                  ; | Name Prefix | Description                                            |
    64                                  ; | ----------- | ------------------------------------------------------ |
    65                                  ; | fw_         | a forth word                                           |
    66                                  ; | xt_         | Execution token (pointer to machine code for the word) |
    67                                  ; | val_        | Runtime value of the variable                          |
    68                                  
